# Copy this file to .env and fill in real values. .env is git-ignored.

# --- OpenSky Network ---
# Leave both blank to fall back to anonymous (heavily rate-limited) access.
# Generate an OAuth2 client (client_id/client_secret) from your OpenSky account
# at https://opensky-network.org/my-opensky -> API Client.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Database ---
POSTGRES_DB=adsb
POSTGRES_USER=adsb
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
